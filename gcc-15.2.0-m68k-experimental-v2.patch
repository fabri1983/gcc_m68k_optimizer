+  operands[3] = GEN_INT ((INTVAL (operands[1]) << 8)
+                         | (INTVAL (operands[2]) & 0xff));
+})
+
+;; Combine: move.w #x,(a0) + move.w #y,2(a0) -> move.l #xy,(a0)
+;; Variant where first access has zero offset
+(define_peephole2
+  [(set (mem:HI (match_operand:SI 0 "register_operand"))
+        (match_operand:HI 1 "const_int_operand"))
+   (set (mem:HI (plus:SI (match_dup 0) (const_int 2)))
+        (match_operand:HI 2 "const_int_operand"))]
+  "reload_completed"
+  [(set (mem:SI (match_dup 0)) (match_dup 3))]
+{
+  operands[3] = GEN_INT ((INTVAL (operands[1]) << 16)
+                         | (INTVAL (operands[2]) & 0xffff));
+})
+
+;; ============================================================
+;; Combine adjacent CLR instructions
+;; ============================================================
+
+;; Combine: clr.b n(a0) + clr.b n+1(a0) -> clr.w n(a0)
+(define_peephole2
+  [(set (mem:QI (plus:SI (match_operand:SI 0 "register_operand")
+                         (match_operand:SI 1 "const_int_operand")))
+        (const_int 0))
+   (set (mem:QI (plus:SI (match_dup 0)
+                         (match_operand:SI 2 "const_int_operand")))
+        (const_int 0))]
+  "reload_completed
+   && INTVAL (operands[2]) == INTVAL (operands[1]) + 1
+   && (!TUNE_68000_10 || (INTVAL (operands[1]) & 1) == 0)"
+  [(set (mem:HI (plus:SI (match_dup 0) (match_dup 1))) (const_int 0))])
+
+;; Combine: clr.w n(a0) + clr.w n+2(a0) -> clr.l n(a0)
+(define_peephole2
+  [(set (mem:HI (plus:SI (match_operand:SI 0 "register_operand")
+                         (match_operand:SI 1 "const_int_operand")))
+        (const_int 0))
+   (set (mem:HI (plus:SI (match_dup 0)
+                         (match_operand:SI 2 "const_int_operand")))
+        (const_int 0))]
+  "reload_completed
+   && INTVAL (operands[2]) == INTVAL (operands[1]) + 2"
+  [(set (mem:SI (plus:SI (match_dup 0) (match_dup 1))) (const_int 0))])
+
+;; Combine: clr.b (a0) + clr.b 1(a0) -> clr.w (a0)
+(define_peephole2
+  [(set (mem:QI (match_operand:SI 0 "register_operand"))
+        (const_int 0))
+   (set (mem:QI (plus:SI (match_dup 0) (const_int 1)))
+        (const_int 0))]
+  "reload_completed && !TUNE_68000_10"
+  [(set (mem:HI (match_dup 0)) (const_int 0))])
+
+;; Combine: clr.w (a0) + clr.w 2(a0) -> clr.l (a0)
+(define_peephole2
+  [(set (mem:HI (match_operand:SI 0 "register_operand"))
+        (const_int 0))
+   (set (mem:HI (plus:SI (match_dup 0) (const_int 2)))
+        (const_int 0))]
+  "reload_completed"
+  [(set (mem:SI (match_dup 0)) (const_int 0))])
+
+;; Combine: clr.b (a0)+ + clr.b (a0)+ -> clr.w (a0)+
+(define_peephole2
+  [(set (mem:QI (post_inc:SI (match_operand:SI 0 "register_operand")))
+        (const_int 0))
+   (set (mem:QI (post_inc:SI (match_dup 0)))
+        (const_int 0))]
+  "reload_completed && !TUNE_68000_10"
+  [(set (mem:HI (post_inc:SI (match_dup 0))) (const_int 0))])
+
+;; Combine: clr.w (a0)+ + clr.w (a0)+ -> clr.l (a0)+
+(define_peephole2
+  [(set (mem:HI (post_inc:SI (match_operand:SI 0 "register_operand")))
+        (const_int 0))
+   (set (mem:HI (post_inc:SI (match_dup 0)))
+        (const_int 0))]
+  "reload_completed"
+  [(set (mem:SI (post_inc:SI (match_dup 0))) (const_int 0))])
+
+;; ============================================================
+;; Multiply and sign-extension peepholes
+;; ============================================================
+
+;; Combine 16-bit signed multiply with sign extension to 32-bit multiply.
+;; muls.w already produces a 32-bit signed result, so the ext.l is redundant.
+;; This converts: muls.w %d1,%d0; ext.l %d0  ->  muls.w %d1,%d0
+;; Note: Changes behavior when 16-bit multiply would overflow (undefined in C).
+(define_peephole2
+  [(set (match_operand:HI 0 "register_operand")
+        (mult:HI (match_dup 0)
+                 (match_operand:HI 1 "general_operand")))
+   (set (match_operand:SI 2 "register_operand")
+        (sign_extend:SI (match_dup 0)))]
+  "REGNO (operands[0]) == REGNO (operands[2])"
+  [(set (match_dup 2)
+        (mult:SI (sign_extend:SI (match_dup 3))
+                 (sign_extend:SI (match_dup 1))))]
+{
+  operands[3] = gen_rtx_REG (HImode, REGNO (operands[2]));
+})
+
+;; Same pattern but with operands swapped (commutative)
+(define_peephole2
+  [(set (match_operand:HI 0 "register_operand")
+        (mult:HI (match_operand:HI 1 "general_operand")
+                 (match_dup 0)))
+   (set (match_operand:SI 2 "register_operand")
+        (sign_extend:SI (match_dup 0)))]
+  "REGNO (operands[0]) == REGNO (operands[2])"
+  [(set (match_dup 2)
+        (mult:SI (sign_extend:SI (match_dup 3))
+                 (sign_extend:SI (match_dup 1))))]
+{
+  operands[3] = gen_rtx_REG (HImode, REGNO (operands[2]));
+})
+
+;; ============================================================
+;; ANDI + ORI folding peepholes
+;; ============================================================
+
+;; Combine andi.l #$ffff + ori.l #xxxx0000 + move.w #yyyy into move.l #xxxxyyyy
+;; The sequence clears upper word, sets it via ORI, then sets lower word.
+;; Final result is a constant that can be loaded directly.
+;; Saves 10 bytes (16 -> 6) and ~28 cycles.
+(define_peephole2
+  [(set (match_operand:SI 0 "register_operand")
+        (and:SI (match_dup 0)
+                (const_int 65535)))
+   (set (match_dup 0)
+        (ior:SI (match_dup 0)
+                (match_operand:SI 1 "const_int_operand")))
+   (set (strict_low_part (match_operand:HI 2 "register_operand"))
+        (match_operand:HI 3 "const_int_operand"))]
+  "DATA_REG_P (operands[0])
+   && REGNO (operands[2]) == REGNO (operands[0])
+   && (INTVAL (operands[1]) & 0xffff) == 0"
+  [(set (match_dup 0) (match_dup 4))]
+{
+  HOST_WIDE_INT upper = INTVAL (operands[1]) & 0xffff0000;
+  HOST_WIDE_INT lower = INTVAL (operands[3]) & 0xffff;
+  operands[4] = GEN_INT (upper | lower);
+})
+
+;; Combine andi.l #$ffff + ori.l #xxxx0000 into swap + move.w #xxxx + swap
+;; Saves 4 bytes (12 -> 8) and ~16 cycles.
+(define_peephole2
+  [(set (match_operand:SI 0 "register_operand")
+        (and:SI (match_dup 0)
+                (const_int 65535)))
+   (set (match_dup 0)
+        (ior:SI (match_dup 0)
+                (match_operand:SI 1 "const_int_operand")))]
+  "DATA_REG_P (operands[0])
+   && (INTVAL (operands[1]) & 0xffff) == 0"
+  [(set (match_dup 0) (rotate:SI (match_dup 0) (const_int 16)))
+   (set (strict_low_part (match_dup 2)) (match_dup 3))
+   (set (match_dup 0) (rotate:SI (match_dup 0) (const_int 16)))]
+{
+  operands[2] = gen_lowpart (HImode, operands[0]);
+  operands[3] = GEN_INT ((INTVAL (operands[1]) >> 16) & 0xffff);
+})
+
+;; NOTE: The mulhi3 pattern uses register_operand for operand 1 (not
+;; general_operand) to prevent combine/fwprop from merging memory loads
+;; into the multiply.  This keeps register pressure visible to IRA and
+;; avoids unnecessary LRA spills in tight loops (e.g. test_matrix_mul).
+
+;; POST_INC reconstruction for LRA-decomposed patterns is handled by
+;; try_merge_postinc in m68k_pass_normalize_autoinc (m68k-rtl-passes.cc),
+;; which generalizes to any instruction type and mode size.
+
+;; ============================================================
+;; Eliminate register intermediate in mem-to-mem copies
+;; ============================================================
+;; When a data register is loaded from memory and immediately stored
+;; to memory, and the register is dead afterward, replace the two
+;; instructions with a direct mem-to-mem move.  Not valid on ColdFire
+;; which lacks mem-to-mem moves.
+
+;; 2-insn: load reg,(mem) + store (mem),reg -> move (mem),(mem)
+;; Register must be dead after the store.
+(define_peephole2
+  [(set (match_operand:I 0 "register_operand")
+        (match_operand:I 1 "memory_operand"))
+   (set (match_operand:I 2 "memory_operand")
+        (match_dup 0))]
+  "reload_completed
+   && !TARGET_COLDFIRE
+   && DATA_REG_P (operands[0])
+   && peep2_reg_dead_p (2, operands[0])"
+  [(set (match_dup 2) (match_dup 1))])
+
+;; 3-insn: load reg,(mem) + store (mem),reg + cbranch reg
+;; -> combined mem-to-mem move + branch on CC from the move.
+;; The register is used only as intermediate + branch test, and is
+;; dead after the branch.  The combined insn (*mov<mode>_mem_cbranch)
+;; emits the move and branch without an explicit tst/cmp.
+;; The (set (pc) ...) must be the first PARALLEL element so that
+;; pc_set() and any_condjump_p() recognize it as a conditional jump.
+(define_peephole2
+  [(set (match_operand:I 0 "register_operand")
+        (match_operand:I 1 "memory_operand"))
+   (set (match_operand:I 2 "memory_operand")
+        (match_dup 0))
+   (set (pc)
+        (if_then_else (match_operator 3 "ordered_comparison_operator"
+                       [(match_dup 0) (const_int 0)])
+                      (label_ref (match_operand 4))
+                      (pc)))]
+  "reload_completed
+   && !TARGET_COLDFIRE
+   && DATA_REG_P (operands[0])
+   && peep2_reg_dead_p (3, operands[0])"
+  [(parallel
+     [(set (pc)
+           (if_then_else (match_op_dup 3 [(match_dup 0) (const_int 0)])
+                         (label_ref (match_dup 4))
+                         (pc)))
+      (set (match_dup 2) (match_dup 1))
+      (clobber (match_dup 0))])])
+
+;; Reversed branch variant.
+(define_peephole2
+  [(set (match_operand:I 0 "register_operand")
+        (match_operand:I 1 "memory_operand"))
+   (set (match_operand:I 2 "memory_operand")
+        (match_dup 0))
+   (set (pc)
+        (if_then_else (match_operator 3 "ordered_comparison_operator"
+                       [(match_dup 0) (const_int 0)])
+                      (pc)
+                      (label_ref (match_operand 4))))]
+  "reload_completed
+   && !TARGET_COLDFIRE
+   && DATA_REG_P (operands[0])
+   && peep2_reg_dead_p (3, operands[0])"
+  [(parallel
+     [(set (pc)
+           (if_then_else (match_op_dup 3 [(match_dup 0) (const_int 0)])
+                         (pc)
+                         (label_ref (match_dup 4))))
+      (set (match_dup 2) (match_dup 1))
+      (clobber (match_dup 0))])])
+
+;; ============================================================
+;; Combine adjacent offset-based memory-to-memory accesses
+;; These patterns fire at peephole2 time before auto-inc synthesis
+;; ============================================================
+
+;; Combine: move.w (a0),(a1) + move.w 2(a0),2(a1) -> move.l (a0),(a1)
+;; First access at register, second at register+2
+(define_peephole2
+  [(set (mem:HI (match_operand:SI 0 "register_operand"))
+        (mem:HI (match_operand:SI 1 "register_operand")))
+   (set (mem:HI (plus:SI (match_dup 0) (const_int 2)))
+        (mem:HI (plus:SI (match_dup 1) (const_int 2))))]
+  "reload_completed"
+  [(set (mem:SI (match_dup 0)) (mem:SI (match_dup 1)))])
+
+;; Combine: move.w n(a0),n(a1) + move.w n+2(a0),n+2(a1) -> move.l n(a0),n(a1)
+;; Both accesses at register+offset
+(define_peephole2
+  [(set (mem:HI (plus:SI (match_operand:SI 0 "register_operand")
+                         (match_operand:SI 2 "const_int_operand")))
+        (mem:HI (plus:SI (match_operand:SI 1 "register_operand")
+                         (match_dup 2))))
+   (set (mem:HI (plus:SI (match_dup 0)
+                         (match_operand:SI 3 "const_int_operand")))
+        (mem:HI (plus:SI (match_dup 1)
+                         (match_dup 3))))]
+  "reload_completed
+   && INTVAL (operands[3]) == INTVAL (operands[2]) + 2"
+  [(set (mem:SI (plus:SI (match_dup 0) (match_dup 2)))
+        (mem:SI (plus:SI (match_dup 1) (match_dup 2))))])
+
+;; Combine: move.w (a0),(a0,d0) + move.w 2(a0),2(a0,d0) -> move.l (a0),(a0,d0)
+;; Indexed destination, register source
+(define_peephole2
+  [(set (mem:HI (plus:SI (match_operand:SI 0 "register_operand")
+                         (match_operand:SI 1 "register_operand")))
+        (mem:HI (match_operand:SI 2 "register_operand")))
+   (set (mem:HI (plus:SI (plus:SI (match_dup 0) (match_dup 1))
+                         (const_int 2)))
+        (mem:HI (plus:SI (match_dup 2) (const_int 2))))]
+  "reload_completed"
+  [(set (mem:SI (plus:SI (match_dup 0) (match_dup 1)))
+        (mem:SI (match_dup 2)))])
+
+;; Combine: move.w n(a0),n(a0,d0) + move.w n+2(a0),n+2(a0,d0)
+;;       -> move.l n(a0),n(a0,d0)
+;; Indexed destination with offset, register source with offset
+(define_peephole2
+  [(set (mem:HI (plus:SI (plus:SI (match_operand:SI 0 "register_operand")
+                                  (match_operand:SI 1 "register_operand"))
+                         (match_operand:SI 4 "const_int_operand")))
+        (mem:HI (plus:SI (match_operand:SI 2 "register_operand")
+                         (match_dup 4))))
+   (set (mem:HI (plus:SI (plus:SI (match_dup 0) (match_dup 1))
+                         (match_operand:SI 5 "const_int_operand")))
+        (mem:HI (plus:SI (match_dup 2)
+                         (match_dup 5))))]
+  "reload_completed
+   && INTVAL (operands[5]) == INTVAL (operands[4]) + 2"
+  [(set (mem:SI (plus:SI (plus:SI (match_dup 0) (match_dup 1))
+                         (match_dup 4)))
+        (mem:SI (plus:SI (match_dup 2) (match_dup 4))))])
+
+;; Combine: move.b (a0),(a1) + move.b 1(a0),1(a1) -> move.w (a0),(a1)
+;; Byte version - only safe on 68020+
+(define_peephole2
+  [(set (mem:QI (match_operand:SI 0 "register_operand"))
+        (mem:QI (match_operand:SI 1 "register_operand")))
+   (set (mem:QI (plus:SI (match_dup 0) (const_int 1)))
+        (mem:QI (plus:SI (match_dup 1) (const_int 1))))]
+  "reload_completed && !TUNE_68000_10"
+  [(set (mem:HI (match_dup 0)) (mem:HI (match_dup 1)))])
+
+;; Combine: move.b n(a0),n(a1) + move.b n+1(a0),n+1(a1) -> move.w n(a0),n(a1)
+;; Byte version with offset - alignment check for 68000/68010
+(define_peephole2
+  [(set (mem:QI (plus:SI (match_operand:SI 0 "register_operand")
+                         (match_operand:SI 2 "const_int_operand")))
+        (mem:QI (plus:SI (match_operand:SI 1 "register_operand")
+                         (match_dup 2))))
+   (set (mem:QI (plus:SI (match_dup 0)
+                         (match_operand:SI 3 "const_int_operand")))
+        (mem:QI (plus:SI (match_dup 1)
+                         (match_dup 3))))]
+  "reload_completed
+   && INTVAL (operands[3]) == INTVAL (operands[2]) + 1
+   && (!TUNE_68000_10 || (INTVAL (operands[2]) & 1) == 0)"
+  [(set (mem:HI (plus:SI (match_dup 0) (match_dup 2)))
+        (mem:HI (plus:SI (match_dup 1) (match_dup 2))))])
diff --git a/gcc/config/m68k/m68k.opt b/gcc/config/m68k/m68k.opt
