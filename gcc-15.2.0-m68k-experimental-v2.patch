+class m68k_pass_sink_for_rmw : public rtl_opt_pass
+{
+public:
+  m68k_pass_sink_for_rmw (gcc::context *ctxt)
+    : rtl_opt_pass (m68k_pass_data_sink_for_rmw, ctxt)
+  {}
